<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.edu-csos.dovamo</groupId>
    <artifactId>dovamo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <artifactId>dovamo-gen-project</artifactId>
  <name>dovamo-gen-project</name>
  <description>Generates a new maven module or eclipse plugin project for the delta dialect of a domain metamodel.</description>
  
  <dependencies>
  <!-- EMF Codegen -->
  <dependency>
    <groupId>org.eclipse.emf</groupId>
    <artifactId>org.eclipse.emf.codegen</artifactId>
    <version>3.00.0</version> <!-- pick version matching your EMF -->
  </dependency>

  <!-- EMF Codegen Ecore -->
  <dependency>
    <groupId>org.eclipse.emf</groupId>
    <artifactId>org.eclipse.emf.codegen.ecore</artifactId>
    <version>2.35.0</version>
  </dependency>

  <!-- Eclipse JDT Core (needed for org.eclipse.jdt.core.dom.*) -->
  <dependency>
    <groupId>org.eclipse.jdt</groupId>
    <artifactId>org.eclipse.jdt.core</artifactId>
    <version>3.32.0</version>
  </dependency>

  <dependency>
    <groupId>com.google.code.gson</groupId>
    <artifactId>gson</artifactId>
    <version>2.11.0</version>
  </dependency>
  
  <!-- https://mvnrepository.com/artifact/org.apache.maven/maven-model -->
  <dependency>
	<groupId>org.apache.maven</groupId>
	<artifactId>maven-model</artifactId>
	<version>3.9.9</version>
  </dependency>
</dependencies>
  
  <build>
    <sourceDirectory>src</sourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>
      
      <plugin>
      	<groupId>org.codehaus.mojo</groupId>
      	<artifactId>exec-maven-plugin</artifactId>
      	<version>3.1.0</version>
      	<configuration>
    		<mainClass>com.example.pipeline.Main</mainClass>
  		</configuration>
	  </plugin>
    </plugins>
  </build>
</project>